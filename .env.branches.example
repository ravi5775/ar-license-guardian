# Shared by all three branches
RUNTIME=edge                 # edge | node
DB_DRIVER=neon               # neon | postgres | none
RATELIMIT_DRIVER=upstash     # upstash | redis | postgres | memory
LICENCE_ROLE=issuer          # issuer (main, self-hosted) | client (client-app)

# --- Database -------------------------------------------------------------
# main:        Neon pooled connection string
# self-hosted: postgres://aether:...@postgres:5432/aether
DATABASE_URL=

# --- Storage (R2, S3-compatible; identical on every branch) ---------------
R2_ACCOUNT_ID=
R2_BUCKET=media
R2_ACCESS_KEY_ID=
R2_SECRET=
R2_PREFIX=                   # model B only: clients/{clientId}
R2_PUBLIC_BASE_URL=          # Cloudflare in front of R2, for cacheable GETs

# --- Rate limiting --------------------------------------------------------
UPSTASH_REDIS_REST_URL=      # main
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=                   # self-hosted, e.g. redis://redis:6379

# --- Licence issuer (main + self-hosted ONLY — never on client-app) -------
# §4.7 presign gating. "true" on customer deployments: no signed media or
# upload URL is issued unless the device holds a valid licence token and its
# build still matches a signed release manifest. Leave unset on our own admin
# deployment and in local dev.
LICENCE_ENFORCE_PRESIGN=false
# Public half of the signing key (derived from LICENCE_PRIVATE_KEY_JWK if unset).
LICENCE_PUBLIC_KEY_JWK=
LICENCE_PRIVATE_KEY_JWK=
RELEASE_MANIFEST_SECRET=
RESEND_API_KEY=
ALERT_TO_EMAIL=

# --- Licence client (client-app ONLY) -------------------------------------
VITE_LICENCE_API_URL=
VITE_LICENCE_KEY=
VITE_LICENCE_PUBLIC_KEY=
VITE_BUILD_ID=

# --- Default admin bootstrap (admin branches ONLY: main + self-hosted) -----
# Used once, on first boot, to create the very first admin account.
# Change the password immediately after first login, then blank these out.
# NEVER set these on client-app.
DEFAULT_ADMIN_EMAIL=admin@your-domain.com
DEFAULT_ADMIN_PASSWORD=change-me-strong-32-chars-min
DEFAULT_ADMIN_TOTP_REQUIRED=true
