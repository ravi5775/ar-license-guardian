# Aether AR — self-hosted (Branch B) environment template.
# Copy to .env and fill in. Never commit the filled version.

NODE_ENV=production
PORT=3000
PUBLIC_SITE_URL=https://your-domain.com

# Postgres (docker-compose.yml)
POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://aether:change-me@127.0.0.1:5432/aether

# Auth (hand-rolled: bcrypt + JWT + otplib TOTP)
JWT_SECRET=generate-a-64-char-random-string
SESSION_COOKIE_NAME=aether_session
TOTP_ISSUER=Aether AR

# Google OAuth (via arctic)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/callback/google

# Cloudflare R2 (S3-compatible) — media + compiled .mind files
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aether-media
R2_PUBLIC_BASE_URL=https://media.your-domain.com

# Vendor license authority (Cloudflare Worker + D1)
VENDOR_LICENSE_URL=https://aether-activation.your-worker.workers.dev
VENDOR_LICENSE_SECRET=
LICENSE_KEY=
DEPLOYMENT_UUID=

# Default admin bootstrap (first boot only — rotate after first login)
DEFAULT_ADMIN_EMAIL=admin@your-domain.com
DEFAULT_ADMIN_PASSWORD=change-me-strong-32-chars-min
DEFAULT_ADMIN_TOTP_REQUIRED=true
