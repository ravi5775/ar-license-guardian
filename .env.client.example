# ============================================================================
# AETHER AR — CLIENT DEPLOYMENT ENVIRONMENT CONFIGURATION (.env)
# ============================================================================
# Use this configuration for each client's dedicated instance.
# All services fit within 100% FREE tiers ($0/month infrastructure cost).
# ============================================================================

# --- 1. Runtime & Role Selection ---
RUNTIME=edge
DB_DRIVER=supabase
RATELIMIT_DRIVER=memory
LICENCE_ROLE=client
NODE_ENV=production

# --- 2. Client Database (Supabase Free Tier / Neon Free Tier) ---
# Paste the client's Supabase project credentials after running `supabase/client-schema.sql`
VITE_SUPABASE_URL=https://your-client-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-client-anon-key
SUPABASE_URL=https://your-client-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-client-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-client-service-role-key

# Optional direct Postgres string if using Neon:
# DATABASE_URL=postgres://...

# --- 3. Shared Cloudflare R2 Media Storage ---
# Use one master Cloudflare R2 bucket and isolate the client with R2_PREFIX
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=aether-media
R2_PREFIX=client-studio-name/
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET=your-r2-secret-key
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# --- 4. Anti-Resale Licensing Guardian ---
# Points to YOUR central Admin authority on `main` branch:
VITE_LICENCE_API_URL=https://admin.your-domain.com
# The unique license key you generated for this client:
VITE_LICENCE_KEY=AETH-XXXX-XXXX-XXXX
# The public verification key corresponding to your master Ed25519 signing key:
VITE_LICENCE_PUBLIC_KEY=your-ed25519-public-key
VITE_BUILD_ID=client-release-v1

# --- 5. Mailer (Optional on client branch) ---
MAILER_DRIVER=resend
RESEND_API_KEY=
MAIL_FROM="Studio AR <noreply@your-client-domain.com>"
