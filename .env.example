# Aether AR — environment reference
#
# Grouped by adapter. Every branch reads the SAME variable names; only the
# values differ. Nothing outside src/lib/adapters/** may read these directly.
#
#   main            RUNTIME=edge  DB_DRIVER=neon      RATELIMIT_DRIVER=upstash  LICENCE_ROLE=issuer
#   self-hosted     RUNTIME=node  DB_DRIVER=postgres  RATELIMIT_DRIVER=redis    LICENCE_ROLE=issuer
#   client-release  RUNTIME=edge  DB_DRIVER=none      RATELIMIT_DRIVER=memory   LICENCE_ROLE=client

# --- Runtime selection ------------------------------------------------------
RUNTIME=edge
DB_DRIVER=neon
RATELIMIT_DRIVER=upstash
MAILER_DRIVER=resend
LICENCE_ROLE=issuer
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# main: Neon pooled connection string. self-hosted: postgres://... :5432/aether
DATABASE_URL=

# --- Storage (R2 / any S3-compatible) ---------------------------------------
R2_ACCOUNT_ID=
R2_BUCKET=media
R2_ACCESS_KEY_ID=
R2_SECRET=
R2_PREFIX=
R2_PUBLIC_BASE_URL=

# --- Rate limiting ----------------------------------------------------------
# RATELIMIT_DRIVER=memory is refused in production: it is per-isolate and
# therefore not a limit at all once more than one worker is running.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# --- Mail -------------------------------------------------------------------
# resend on edge, smtp on self-hosted, log in development.
RESEND_API_KEY=
SMTP_URL=
MAIL_FROM="Aether AR <licensing@your-domain.com>"
ALERT_TO_EMAIL=
ADMIN_BASE_URL=https://admin.your-domain.com

# --- Licence issuer (main + self-hosted ONLY — never on client-release) -----
# §4.7 presign gating. "true" on customer deployments: no signed media or
# upload URL is issued unless the device holds a valid licence token and its
# build still matches a signed release manifest. Leave unset on our own admin
# deployment and in local dev.
LICENCE_ENFORCE_PRESIGN=false
# Public half of the signing key (derived from LICENCE_PRIVATE_KEY_JWK if unset).
LICENCE_PUBLIC_KEY_JWK=
LICENCE_PRIVATE_KEY_JWK=
RELEASE_MANIFEST_SECRET=

# --- Licence client (client-release ONLY) -----------------------------------
VITE_LICENCE_API_URL=
VITE_LICENCE_KEY=
VITE_LICENCE_PUBLIC_KEY=
VITE_BUILD_ID=

# --- First-boot admin (admin branches ONLY) ---------------------------------
# Used once to create the first admin. Rotate and blank immediately after.
DEFAULT_ADMIN_EMAIL=admin@your-domain.com
DEFAULT_ADMIN_PASSWORD=change-me-strong-32-chars-min
DEFAULT_ADMIN_TOTP_REQUIRED=true
